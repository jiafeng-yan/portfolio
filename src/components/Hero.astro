---
// src/components/Hero.astro
---

<section class="hero" data-section="hero" aria-labelledby="hero-thesis">
  <div class="hero__grid">
    <div class="hero__col">
      <p class="hero__meta">
        <span>中央财经大学</span>
        <span class="hero__meta-sep">·</span>
        <span>人工智能硕士在读（本硕推免）</span>
        <span class="hero__meta-sep">·</span>
        <span>2026 — 至今</span>
      </p>

      <h1 class="hero__thesis" id="hero-thesis">
        把看不清的地方，<br />
        <span class="hero__thesis-accent">算清楚。</span>
      </h1>

      <p class="hero__bio">
        研究方向为恶劣天气下的图像恢复与多模态融合，以及遥感视觉问答与推理分割；工程上也做多模态检索系统和移动端模型部署。
      </p>

      <div class="hero__signature">
        <span class="hero__signature-rule" aria-hidden="true"></span>
        <span class="hero__signature-name">闫家锋</span>
        <span class="hero__signature-latin">Yan Jiafeng</span>
      </div>

      <div class="hero__links" aria-label="联系方式">
        <a
          href="https://github.com/jiafeng-yan"
          target="_blank"
          rel="noopener noreferrer"
          class="hero__link"
          data-cursor-hover
        >
          GitHub
        </a>
        <button class="hero__link" data-cursor-hover data-copy="yan.jiafeng@email.cufe.edu.cn">
          Email
        </button>
        <button class="hero__link" data-cursor-hover data-wechat-btn>
          微信
        </button>
        <a href="tel:+8613935252657" class="hero__link" data-cursor-hover>
          电话
        </a>
      </div>

      <p class="hero__status">
        最近 · IEEE/CAA JAS 录用 · AAAI 2026 收录 · TIP / ICLR 在投
      </p>
    </div>

    <nav class="hero__index" aria-label="空间索引">
      <ol>
        <li>
          <a href="#profile" data-cursor-hover>
            <span class="hero__index-num">01</span>
            <span class="hero__index-label">关于</span>
            <span class="hero__index-hint">本硕背景、成绩与核心课程</span>
          </a>
        </li>
        <li>
          <a href="#projects" data-cursor-hover>
            <span class="hero__index-num">02</span>
            <span class="hero__index-label">项目</span>
            <span class="hero__index-hint">论文课题、横向与开源工程</span>
          </a>
        </li>
        <li>
          <a href="#skills" data-cursor-hover>
            <span class="hero__index-num">03</span>
            <span class="hero__index-label">技能</span>
            <span class="hero__index-hint">技术栈与常用工具</span>
          </a>
        </li>
        <li>
          <a href="#experience" data-cursor-hover>
            <span class="hero__index-num">04</span>
            <span class="hero__index-label">经历</span>
            <span class="hero__index-hint">竞赛获奖、学生工作与实习</span>
          </a>
        </li>
        <li>
          <a href="#stats" data-cursor-hover>
            <span class="hero__index-num">05</span>
            <span class="hero__index-label">记录</span>
            <span class="hero__index-hint">GitHub 与 LeetCode 统计</span>
          </a>
        </li>
      </ol>
    </nav>
  </div>

  <div class="hero__foot">
    <span class="hero__coord">北京 · 39.96°N 116.36°E</span>
    <a href="#profile" class="hero__advance" data-cursor-hover aria-label="进入下一节：关于">
      继续 <span class="hero__advance-arrow" aria-hidden="true">↓</span>
    </a>
  </div>

  <div class="hero__signal" id="heroSignal" aria-hidden="true">
    <div class="hero__signal-track hero__signal-track--outer">
      <span class="hero__signal-satellite hero__signal-satellite--1"></span>
    </div>
    <div class="hero__signal-track hero__signal-track--middle">
      <span class="hero__signal-satellite hero__signal-satellite--2"></span>
    </div>
    <div class="hero__signal-track hero__signal-track--inner">
      <span class="hero__signal-satellite hero__signal-satellite--3"></span>
    </div>
    <div class="hero__signal-core">
      <span class="hero__signal-core-glow"></span>
      <span class="hero__signal-dot"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: clamp(5.5rem, 11vh, 8rem) var(--page-gutter) clamp(3rem, 7vh, 4.5rem);
    overflow: hidden;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    width: min(var(--max-width), 100%);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .hero__col {
    max-width: 40rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
    margin-bottom: clamp(1.6rem, 3vh, 2.4rem);
  }

  .hero__meta-sep {
    color: var(--color-border-strong);
  }

  .hero__thesis {
    font-size: clamp(2.15rem, 4.4vw, 3.7rem);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-text);
    margin-bottom: clamp(1.5rem, 3vh, 2rem);
    text-wrap: balance;
  }

  .hero__thesis-accent {
    color: var(--color-primary-ink);
  }

  .hero__bio {
    max-width: 33rem;
    font-size: 1.02rem;
    line-height: 2;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .hero__signature {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: clamp(1.8rem, 4vh, 2.8rem);
  }

  .hero__signature-rule {
    width: 1.8rem;
    height: 1px;
    background: rgba(44, 40, 37, 0.3);
  }

  .hero__signature-name {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.06em;
  }

  .hero__signature-latin {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--color-text-subtle);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.4rem;
    margin-top: 1.5rem;
  }

  /* a 与 button 混排：统一字体、清零浏览器默认内边距，保证基线对齐 */
  .hero__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    margin: 0;
    padding: 0 0 3px;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    text-align: left;
    transition:
      color var(--duration-fast),
      border-color var(--duration-fast);
  }

  .hero__link:hover,
  .hero__link:focus-visible {
    color: var(--color-text);
    border-bottom-color: var(--color-primary);
  }

  .hero__foot {
    position: absolute;
    z-index: 1;
    left: var(--page-gutter);
    right: var(--page-gutter);
    bottom: clamp(1.4rem, 3.5vh, 2.4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }

  .hero__advance {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0 0.35rem 0.6rem;
    color: var(--color-text-subtle);
    white-space: nowrap;
    transition: color var(--duration-fast);
  }

  .hero__advance:hover,
  .hero__advance:focus-visible {
    color: var(--color-text);
  }

  .hero__advance-arrow {
    display: inline-block;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .hero__advance:hover .hero__advance-arrow {
    transform: translateY(3px);
  }

  .hero__status {
    margin-top: clamp(2rem, 5vh, 3rem);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.8;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
  }

  /* 空间索引 */
  .hero__index {
    position: relative;
    z-index: 1;
    justify-self: end;
    width: 100%;
    max-width: 26rem;
  }

  .hero__index ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .hero__index li {
    border-bottom: 1px solid var(--color-border);
  }

  .hero__index a {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.95rem 0.85rem;
    border-radius: 6px;
    transition:
      transform var(--duration-normal) var(--ease-out-expo),
      background var(--duration-normal) var(--ease-out-expo);
  }

  .hero__index a:hover,
  .hero__index a:focus-visible {
    transform: translateX(5px);
    background: rgba(255, 255, 255, 0.5);
  }

  .hero__index-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-subtle);
    letter-spacing: 0.08em;
    transition: color var(--duration-fast);
  }

  .hero__index-label {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: 0.04em;
  }

  .hero__index-hint {
    font-size: 0.8rem;
    color: var(--color-text-subtle);
    text-align: right;
    line-height: 1.6;
  }

  .hero__index a:hover .hero__index-num,
  .hero__index a:focus-visible .hero__index-num {
    color: var(--color-primary-ink);
  }

  /* 天体轨道 */
  .hero__signal {
    position: absolute;
    z-index: 0;
    right: clamp(-9rem, -6vw, -4rem);
    top: clamp(-7rem, -8vh, -4rem);
    width: clamp(14rem, 21vw, 20rem);
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0.8;
    perspective: 800px;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .hero__signal-track {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px dashed rgba(184, 112, 74, 0.4);
    transform-style: preserve-3d;
  }

  .hero__signal-track--outer {
    border-style: solid;
    border-width: 1px;
    border-color: rgba(184, 112, 74, 0.32);
    animation: orbitRotateOuter 26s linear infinite;
  }

  .hero__signal-track--middle {
    inset: 18%;
    border-color: rgba(122, 155, 184, 0.46);
    border-style: dashed;
    animation: orbitRotateMiddle 19s linear infinite reverse;
  }

  .hero__signal-track--inner {
    inset: 36%;
    border-color: rgba(201, 139, 122, 0.44);
    border-style: dotted;
    animation: orbitRotateInner 13s linear infinite;
  }

  .hero__signal-satellite {
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 8px rgba(184, 112, 74, 0.5);
  }

  .hero__signal-satellite--2 {
    width: 5px;
    height: 5px;
    background: var(--color-ink-blue);
    box-shadow: 0 0 6px rgba(122, 155, 184, 0.5);
  }

  .hero__signal-satellite--3 {
    width: 4px;
    height: 4px;
    background: #c98b7a;
    box-shadow: 0 0 5px rgba(201, 139, 122, 0.5);
  }

  .hero__signal-core {
    position: absolute;
    inset: 46%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__signal-core-glow {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184, 112, 74, 0.3) 0%, transparent 70%);
    animation: corePulse 4s ease-in-out infinite;
  }

  .hero__signal-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-text);
    opacity: 0.55;
  }

  @keyframes orbitRotateOuter {
    0% { transform: rotate(0deg) rotateX(15deg); }
    100% { transform: rotate(360deg) rotateX(15deg); }
  }

  @keyframes orbitRotateMiddle {
    0% { transform: rotate(0deg) rotateY(25deg); }
    100% { transform: rotate(360deg) rotateY(25deg); }
  }

  @keyframes orbitRotateInner {
    0% { transform: rotate(0deg) rotateX(-20deg); }
    100% { transform: rotate(360deg) rotateX(-20deg); }
  }

  @keyframes corePulse {
    0%, 100% { transform: scale(1); opacity: 0.4; }
    50% { transform: scale(1.35); opacity: 0.8; }
  }

  @media (max-width: 1024px) {
    .hero__index-hint {
      display: none;
    }

    .hero__index a {
      grid-template-columns: 2.2rem minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      padding: clamp(4.5rem, 12vh, 6rem) var(--space-lg) var(--space-lg);
    }

    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero__col {
      max-width: none;
    }

    .hero__thesis {
      font-size: clamp(1.95rem, 7.2vw, 2.6rem);
    }

    .hero__bio {
      font-size: 0.96rem;
      line-height: 1.9;
    }

    .hero__index {
      justify-self: stretch;
      max-width: none;
    }

    .hero__index a {
      padding: 0.8rem 0.65rem;
    }

    .hero__foot {
      position: static;
      margin-top: 2.2rem;
    }

    .hero__signal {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 4.5rem var(--space-md) var(--space-lg);
    }

    .hero__meta {
      font-size: 0.64rem;
      letter-spacing: 0.08em;
    }

    .hero__links {
      gap: 1.1rem;
    }

    .hero__status {
      font-size: 0.63rem;
      line-height: 1.7;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__signal-track,
    .hero__signal-core-glow {
      animation: none;
    }
  }

  /* 离开视口后暂停轨道动画，滚到下方阅读时不再持续重算样式 */
  .hero.is-offscreen .hero__signal-track,
  .hero.is-offscreen .hero__signal-core-glow {
    animation-play-state: paused;
  }
</style>

<script>
  // 天体雕塑的轻微陀螺仪倾斜（仅桌面）
  const signal = document.getElementById('heroSignal');
  const hero = document.querySelector<HTMLElement>('.hero');

  // 首屏离开视口后暂停轨道动画与倾斜循环：
  // 三个环 + 核心脉冲是纯 CSS 动画，滚到下面阅读时没必要继续跑。
  let heroVisible = true;
  if (hero && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        heroVisible = entry.isIntersecting;
        hero.classList.toggle('is-offscreen', !entry.isIntersecting);
      },
      { rootMargin: '120px' }
    );
    observer.observe(hero);
  }

  if (signal && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let targetTiltX = 0;
    let targetTiltY = 0;
    let currentTiltX = 0;
    let currentTiltY = 0;
    let rafId: number;

    const handleMouseMove = (e: MouseEvent) => {
      const cx = window.innerWidth / 2;
      const cy = window.innerHeight / 2;
      targetTiltX = ((e.clientY - cy) / cy) * -12;
      targetTiltY = ((e.clientX - cx) / cx) * 12;
    };

    const updateTilt = () => {
      rafId = requestAnimationFrame(updateTilt);
      if (!heroVisible) return;

      const nextX = currentTiltX + (targetTiltX - currentTiltX) * 0.05;
      const nextY = currentTiltY + (targetTiltY - currentTiltY) * 0.05;
      // 收敛后不再写样式，避免每帧产生一次无意义的样式失效
      if (Math.abs(nextX - currentTiltX) < 0.01 && Math.abs(nextY - currentTiltY) < 0.01) return;

      currentTiltX = nextX;
      currentTiltY = nextY;
      signal.style.transform = `translateY(-50%) rotateX(${currentTiltX}deg) rotateY(${currentTiltY}deg)`;
    };

    window.addEventListener('mousemove', handleMouseMove, { passive: true });
    rafId = requestAnimationFrame(updateTilt);

    document.addEventListener('astro:before-preparation', () => {
      window.removeEventListener('mousemove', handleMouseMove);
      if (rafId) cancelAnimationFrame(rafId);
    }, { once: true });
  }

  // 复制联系方式 - 触发自定义事件供 Toast 使用
  document.querySelectorAll('[data-copy]').forEach(button => {
    button.addEventListener('click', async () => {
      const text = button.getAttribute('data-copy');
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        window.dispatchEvent(new CustomEvent('show-toast', {
          detail: { message: '已复制到剪贴板', type: 'success' }
        }));
      } catch (err) {
        window.dispatchEvent(new CustomEvent('show-toast', {
          detail: { message: '复制失败', type: 'error' }
        }));
      }
    });
  });
</script>
