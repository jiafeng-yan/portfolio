---
// src/components/Skills.astro

const skills = [
  {
    category: '编程语言',
    items: ['Python', 'C++', 'React', 'R', 'MATLAB', 'Lingo']
  },
  {
    category: '研究与算法',
    items: ['计算机视觉', '图像融合', '多模态微调', '图神经网络', '信息检索', '数据挖掘']
  },
  {
    category: '工程工具',
    items: ['PyTorch', 'VSCode', 'Conda', 'Git', 'LLaMA Factory', 'DeepSpeed', 'Docker']
  },
  {
    category: '系统实践',
    items: ['Lucene', 'Grobid', 'Flask', 'OCR', 'RAG', 'SAM']
  }
];
---

<section class="skills" id="skills" data-section="skills" aria-labelledby="skills-title">
  <div class="skills__header">
    <span class="section-kicker">03 / 技能</span>
    <h2 id="skills-title">手上有的工具</h2>
    <p>
      研究侧偏视觉低层任务与检索，工程侧从数据处理一直写到前端展示。英语 CET-6，读论文和写邮件够用。
    </p>
  </div>

  <div class="skills__grid">
    {skills.map(({ category, items }) => (
      <article class="skills__category">
        <h3 class="skills__category-title">{category}</h3>
        <ul class="skills__list">
          {items.map((item) => (
            <li class="skills__item">{item}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .skills {
    width: min(var(--max-width), 100% - 2 * var(--page-gutter));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 6rem);
  }

  .skills__header {
    max-width: 64rem;
    margin-bottom: var(--space-xl);
  }

  .skills__header h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
    line-height: 1.3;
    margin: var(--space-sm) 0 var(--space-md);
  }

  .skills__header p {
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .skills__category {
    padding-top: var(--space-md);
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .skills__category-title {
    font-size: 0.92rem;
    color: var(--color-primary-ink);
    margin-bottom: var(--space-md);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .skills__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .skills__item {
    padding: var(--space-xs) var(--space-sm);
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    font-size: 0.86rem;
    color: var(--color-text-muted);
    transition:
      background var(--duration-fast),
      border-color var(--duration-fast),
      color var(--duration-fast);
  }

  .skills__item:hover {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(184, 112, 74, 0.3);
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .skills {
      padding-block: clamp(2.5rem, 5vw, 6rem);
    }

    .skills__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .skills {
      padding-block: clamp(2.5rem, 5vw, 6rem);
    }

    .skills__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
