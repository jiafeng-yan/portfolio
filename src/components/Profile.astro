---
const profileRows = [
  {
    label: '教育',
    title: '中央财经大学（211）· 信息学院',
    detail: '计算机科学与技术本科生 · 已保研至本院人工智能方向',
    meta: '2022 — 2026'
  },
  {
    label: '排名',
    title: '加权排名 4 / 30 · 综测排名 3 / 30',
    detail: 'GPA 3.76 / 4.5',
    meta: '前 13%'
  },
  {
    label: '课程',
    title: '408、编译原理、机器学习、人工智能、计算机视觉、自然语言处理、数据挖掘、信息检索',
    detail: '概率论与数理统计 99 · Python 98 · 高等数学 96 · C++ 95 · 离散数学 95',
    meta: '核心课'
  },
  {
    label: '联系',
    title: 'yan.jiafeng@email.cufe.edu.cn',
    detail: 'GitHub：jiafeng-yan · 电话 / 微信：139 3525 2657',
    meta: ''
  }
];
---

<section class="profile" id="profile" data-section="profile" aria-labelledby="profile-title">
  <div class="profile__intro">
    <span class="section-kicker">01 / 关于</span>
    <h2 id="profile-title">教育背景与研究方向</h2>
    <p>
      大二进组后开始接触图像融合与底层视觉任务，目前研究集中在多退化恢复、红外-可见光融合及遥感推理分割。除了算法实验与论文撰写，也做过本地文献检索、多模态 RAG 原型与前后端部署。
    </p>
  </div>

  <div class="profile__rows">
    {profileRows.map((row) => (
      <article class="profile__row spotlight-card" data-spotlight data-cursor-hover>
        <span class="profile__row-label">{row.label}</span>
        <div>
          <h3>{row.title}</h3>
          <p>{row.detail}</p>
        </div>
        <span class="profile__row-meta">{row.meta}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .profile {
    width: min(var(--max-width), 100% - 2 * var(--page-gutter));
    margin-inline: auto;
    padding-block: var(--space-2xl) var(--space-xl);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .profile__intro {
    position: sticky;
    top: var(--space-xl);
  }

  .profile__intro h2 {
    font-size: clamp(1.7rem, 3.1vw, 2.4rem);
    line-height: 1.4;
    margin: var(--space-sm) 0 var(--space-lg);
    max-width: 15em;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .profile__intro p {
    color: var(--color-text-muted);
    line-height: 1.9;
    max-width: 34rem;
  }

  .profile__rows {
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    margin-top: 0.45rem;
  }

  .profile__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: var(--space-lg);
    padding: var(--space-lg) var(--space-md);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: var(--border-radius);
    align-items: start;
    transition:
      background var(--duration-fast),
      transform var(--duration-normal) var(--ease-out-expo);
  }

  .profile__row:hover {
    background: rgba(255, 255, 255, 0.65);
    transform: translateX(4px);
  }

  .profile__row-label,
  .profile__row-meta {
    font-size: 0.76rem;
    color: var(--color-text-subtle);
    letter-spacing: 0.08em;
  }

  .profile__row-label {
    padding-top: 0.15rem;
  }

  .profile__row h3 {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: var(--space-xs);
  }

  .profile__row p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .profile {
      grid-template-columns: 1fr;
      padding-block: clamp(2.5rem, 5vw, 6rem);
    }

    .profile__intro {
      position: static;
    }

    .profile__intro h2 {
      max-width: 12em;
    }
  }

  @media (max-width: 640px) {
    .profile {
      padding-block: clamp(2.5rem, 5vw, 6rem);
    }

    .profile__row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
      padding: var(--space-md) 0;
    }

    .profile__row-meta {
      order: -1;
    }
  }
</style>
